# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored Anthropic skills (독점 라이선스 — 저장소에 커밋하지 않음, 로컬에서만 사용)
.claude/skills/

# Playwright MCP 산출물(스냅샷·스크린샷·다운로드) — 로컬 검증용, 커밋하지 않음
.playwright-mcp/
